<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.github.janino-lts</groupId>
		<artifactId>janino-querysim</artifactId>
		<version>0.1.0-SNAPSHOT</version>
	</parent>

	<artifactId>qsim-harness</artifactId>
	<name>qsim-harness</name>
	<description>Differential comparison, class file comparison, ledger, minimizer and test suites</description>

	<properties>
		<!-- Which directories the tests use; -Dqsim.baseline.dir and -Dqsim.candidate.dir override them. -->
		<qsim.baseline.dir>${project.build.directory}/janino-baseline</qsim.baseline.dir>
		<qsim.candidate.dir>${project.build.directory}/janino-candidate</qsim.candidate.dir>
	</properties>

	<dependencies>
		<dependency>
			<groupId>io.github.janino-lts</groupId>
			<artifactId>qsim-runtime</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.janino-lts</groupId>
			<artifactId>qsim-plan</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.janino-lts</groupId>
			<artifactId>qsim-codegen</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.janino-lts</groupId>
			<artifactId>qsim-backend-api</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.janino-lts</groupId>
			<artifactId>qsim-backend-javac</artifactId>
		</dependency>
		<!-- The class file comparison and the raw data of the reports. -->
		<dependency>
			<groupId>org.ow2.asm</groupId>
			<artifactId>asm-tree</artifactId>
		</dependency>
		<dependency>
			<groupId>org.ow2.asm</groupId>
			<artifactId>asm-util</artifactId>
		</dependency>
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
		</dependency>
		<!-- Not on any class path: the type "pom" only makes the reactor build the adapter first, so that
		     the dependency plugin below can copy its JAR. The harness must not see the adapter or Janino. -->
		<dependency>
			<groupId>io.github.janino-lts</groupId>
			<artifactId>qsim-backend-janino</artifactId>
			<version>${project.version}</version>
			<type>pom</type>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Copies the JARs of each Janino version and the adapter; see the parent POM. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<qsim.baseline.dir>${qsim.baseline.dir}</qsim.baseline.dir>
						<qsim.candidate.dir>${qsim.candidate.dir}</qsim.candidate.dir>
						<qsim.baseline.version>${qsim.baseline.version}</qsim.baseline.version>
						<qsim.candidate.version>${qsim.candidate.version}</qsim.candidate.version>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
